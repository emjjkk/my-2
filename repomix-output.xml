@import "tailwindcss";

@custom-variant dark (&:where(.dark, .dark *));

@layer base {
  :root {
    --ink: #141413;
    --paper: #fbfbf9;
    --font-serif: var(--font-serif), "Newsreader", Georgia, Cambria, "Times New Roman", serif;
    --font-mono: var(--font-mono), "Geist Mono", "IBM Plex Mono", ui-monospace, monospace;
    --font-sans: var(--font-sans), "Geist", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }

  .dark {
    --ink: #ecebe8;
    --paper: #121314;
  }

  html {
    background-color: var(--paper);
    color: var(--ink);
  }

  body {
    font-family: var(--font-sans);
    background-color: var(--paper);
