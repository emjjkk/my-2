.font-mono-ink {
  font-family: var(--font-mono);
}

.font-sans-ink {
  font-family: var(--font-sans);
}

/* E-Ink Refresh Flash Effect */
@keyframes eink-flash {
  0% {
    filter: invert(1) contrast(200%);
    opacity: 0.92;
  }
  50% {
    filter: invert(0) contrast(140%);
    opacity: 0.97;
  }
  100% {
    filter: invert(0) contrast(100%);
    opacity: 1;
  }
}

.eink-refreshing {
  animation: eink-flash 240ms cubic-bezier(0.4, 0, 0.2, 1);
}

/* Minimal E-Ink Canvas */
.e-ink-container {
  background-color: var(--paper);
  color: var(--ink);
  transition: background-color 0.12s ease, color 0.12s ease;
